# FREDDIESHOTIT environment variables
#
# Leave these blank/unset to run in STANDALONE mode: the site works exactly
# as a normal template — single admin password, localStorage-only data.
#
# Fill these in to run in PLATFORM mode as a real EKO PIXELS tenant: admin
# login becomes real Supabase Auth (email + password), and bookings/settings
# sync to the shared database (and are visible from the Super Admin).

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# The tenant row id for this site (from the `tenants` table). The Super Admin
# shows you this after you create the tenant — copy it here.
VITE_TENANT_ID=""
